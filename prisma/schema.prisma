generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Neon's pooled connection (PgBouncer, transaction mode) doesn't support the advisory locks
  // `prisma migrate deploy` needs — migrations must run through the direct/unpooled connection.
  // Locally, DATABASE_URL_UNPOOLED just mirrors DATABASE_URL (no pooler in the sandbox).
  directUrl         = env("DATABASE_URL_UNPOOLED")
  // Dedicated database `migrate dev`/`migrate diff` use to compute schema drift. Must NEVER
  // point at the same database/schema as `url` above — without this, drift resolution targets
  // the real dev database directly and a non-interactive "reset?" prompt can silently wipe it
  // (see docs/database-migrations.md for the incident this prevents).
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum SeriesLifecycleStatus {
  RETURNING
  ENDED
  CANCELED
  IN_PRODUCTION
  PILOT
}

enum WatchState {
  WANT_TO_WATCH
  WATCHING
  PAUSED
  DROPPED
  COMPLETED
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum ExternalSource {
  TMDB
}

enum ExternalEntityType {
  SERIES
  SEASON
  EPISODE
}

enum ActivityType {
  EPISODE_WATCHED
  SERIES_STATUS_CHANGED
  SERIES_COMPLETED
  REVIEW_CREATED
  LIST_CREATED
  USER_FOLLOWED
  // Fase 3/8 (INSERIES-REVIEWS-COMMENTS-PREMIUM-01) — aditivo, alimenta a Timeline do Perfil
  // (getProfileActivity/ActivityCard, ja reutilizados sem alteracao).
  COMMENT_CREATED
}

enum CatalogSyncType {
  POPULAR_SERIES
  SERIES_DETAILS
  SERIES_SEASONS
  SERIES_EPISODES
  FULL_REFRESH
  TOP_RATED
  ON_THE_AIR
  AIRING_TODAY
  DISCOVER
  TRENDING
  CATALOG_FULL
  COVERAGE
  DISCOVERY_ENGINE
}

enum CatalogSyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum NotificationType {
  NEW_EPISODE_AVAILABLE
  FOLLOWED_YOU
  REVIEW_FROM_FOLLOWING
  LIST_FROM_FOLLOWING
  SERIES_COMPLETED
  ADMIN_NOTICE
  ACHIEVEMENT_UNLOCKED
  // INSERIES-SOCIAL-NETWORK-EXPERIENCE-01 — solicitacoes de seguir (perfil privado) e
  // interacoes em atividades (curtida/comentario).
  FOLLOW_REQUESTED
  FOLLOW_REQUEST_ACCEPTED
  ACTIVITY_LIKED
  ACTIVITY_COMMENTED
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AchievementCategory {
  WATCHING
  SOCIAL
  COLLECTION
  STREAK
  REVIEW
  SPECIAL
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  username                String                   @unique
  email                   String                   @unique
  passwordHash            String
  avatarUrl               String?
  bio                     String?
  role                    UserRole                 @default(USER)
  lastLoginAt             DateTime?
  isProfilePrivate        Boolean                  @default(false)
  showWatchedSeries       Boolean                  @default(true)
  showWatchingSeries      Boolean                  @default(true)
  showLists               Boolean                  @default(true)
  showReviews             Boolean                  @default(true)
  showActivity            Boolean                  @default(true)
  // INSERIES-SERIES-STATUS-ENGINE-01 — "pausar automaticamente series inativas": preferencia
  // do usuario, nunca aplicada retroativamente por um cron sem consentimento (default ligado,
  // mas sempre reversivel em Configuracoes). `autoPauseInactiveDays: null` = "Nunca" (a
  // automacao fica desligada na pratica sem precisar de um segundo boolean). O periodo
  // sugerido pelo ticket (60 dias) e o default de uma nova conta.
  autoPauseInactiveSeries Boolean                  @default(true)
  autoPauseInactiveDays   Int?                     @default(60)
  // INSERIES-SUPPORTER-ACTIVATION-01 — replaced the old boolean `isSupporter` with a proper
  // UserSupporter record (status/startedAt/expiresAt): "Nao utilizar apenas um campo
  // booleano". Every benefit reads UserSupporter.status === ACTIVE, never a field on User
  // directly. `showSupporterBadge`/banner/frame remain here since they're cosmetic
  // *preferences*, not eligibility — a user can be an inactive ex-supporter and keep them set.
  showSupporterBadge      Boolean                  @default(true)
  supporterBannerStyle    String?
  supporterFrameStyle     String?
  statuses                UserSeriesStatus[]
  episodeProgress         UserEpisodeProgress[]
  followers               Follow[]                 @relation("followers")
  following               Follow[]                 @relation("following")
  reviews                 Review[]
  comments                Comment[]
  ratings                 Rating[]
  lists                   List[]
  activities              Activity[]               @relation("ActivityUser")
  targetedActivities      Activity[]               @relation("ActivityTargetUser")
  notifications           Notification[]           @relation("NotificationUser")
  actorNotifications      Notification[]           @relation("NotificationActor")
  adminAuditLogs          AdminAuditLog[]
  achievements            UserAchievement[]
  // INSERIES-SOCIAL-NETWORK-EXPERIENCE-01
  followRequestsSent      FollowRequest[]          @relation("FollowRequestsSent")
  followRequestsReceived  FollowRequest[]          @relation("FollowRequestsReceived")
  mutesGiven              Mute[]                   @relation("MutesGiven")
  mutesReceived           Mute[]                   @relation("MutesReceived")
  blocksGiven             Block[]                  @relation("BlocksGiven")
  blocksReceived          Block[]                  @relation("BlocksReceived")
  activityLikes           ActivityLike[]
  activityComments        ActivityComment[]
  importJobs              ImportJob[]
  recommendationFeedback  RecommendationFeedback[]
  supportRequests         SupportRequest[]
  supporterStatus         UserSupporter?
  supporterPollVotes      SupporterPollVote[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([role])
}

enum ImportJobStatus {
  ANALYZED
  IMPORTING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  CANCELLED
  UNDONE
}

// INSERIES-HISTORY-IMPORT-AND-DATA-PORTABILITY-01 — um job por arquivo analisado. O manifesto
// normalizado (itens + correspondencias) fica em `manifest` (Json); a execucao processa em
// lotes (client-driven, `processedCount` e o checkpoint) e o resultado agregado + ids criados
// (pra desfazer) ficam em `report`.
model ImportJob {
  id             String          @id @default(cuid())
  userId         String
  source         String
  fileName       String
  status         ImportJobStatus @default(ANALYZED)
  conflictPolicy String          @default("keep_existing")
  manifest       Json
  totals         Json
  processedCount Int             @default(0)
  report         Json?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, createdAt])
}

model FollowRequest {
  id          String              @id @default(cuid())
  requesterId String
  targetId    String
  status      FollowRequestStatus @default(PENDING)
  requester   User                @relation("FollowRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User                @relation("FollowRequestsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([requesterId, targetId])
  @@index([targetId, status])
}

model Mute {
  id        String   @id @default(cuid())
  userId    String
  mutedId   String
  user      User     @relation("MutesGiven", fields: [userId], references: [id], onDelete: Cascade)
  muted     User     @relation("MutesReceived", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mutedId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model ActivityLike {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
}

model ActivityComment {
  id              String            @id @default(cuid())
  activityId      String
  userId          String
  parentId        String?
  body            String
  hiddenByAdminAt DateTime?
  activity        Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent          ActivityComment?  @relation("ActivityCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         ActivityComment[] @relation("ActivityCommentReplies")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([activityId])
  @@index([parentId])
}

model Series {
  id                     String                   @id @default(cuid())
  slug                   String                   @unique
  title                  String
  originalTitle          String?
  overview               String?
  posterUrl              String?
  backdropUrl            String?
  firstAirYear           Int?
  language               String?
  network                String?
  genres                 String[]
  status                 SeriesLifecycleStatus
  popularityScore        Float?
  voteAverage            Float?
  voteCount              Int?
  // Fase 9 (INSERIES-TMDB-CATALOG-SCALE-01) — richer catalog metadata, all sourced from the
  // same single TMDb details call (network already existed; the rest just wasn't captured
  // before). Nothing here is surfaced in the UI yet — this is data warehousing for future use,
  // not a new user-facing feature.
  tagline                String?
  homepage               String?
  originCountry          String[]                 @default([])
  spokenLanguages        String[]                 @default([])
  numberOfSeasons        Int?
  numberOfEpisodes       Int?
  networks               String[]                 @default([])
  productionCountries    String[]                 @default([])
  productionCompanies    String[]                 @default([])
  createdBy              String[]                 @default([])
  logoUrl                String?
  keywords               String[]                 @default([])
  // Fase 2/4/7/8 (INSERIES-TMDB-CATALOG-QUALITY-01) — editorial quality layer on top of the
  // raw metadata above. qualityScore/collectionTags are derived+persisted at upsert time
  // (lib/catalog/quality-score.ts, lib/catalog/collection-tags.ts); watchProviders/type come
  // straight from the same TMDb details call (append_to_response), no extra HTTP call.
  qualityScore           Float?
  watchProviders         String[]                 @default([])
  collectionTags         String[]                 @default([])
  type                   String?
  // Fase 17/18/19 (INSERIES-CATALOG-SERIES-EXPERIENCE-01) — elenco/galeria/trailers, todos
  // vindos do mesmo `tv/{id}` details call (append_to_response: credits/images/videos), sem
  // chamada extra ao TMDb. `cast`/`videos` sao arrays de objeto (poucos campos cada, sem
  // necessidade de tabela propria); `backdropUrls`/`posterUrls` seguem o mesmo padrao
  // String[] ja usado pra genres/keywords/etc.
  cast                   Json[]                   @default([])
  videos                 Json[]                   @default([])
  backdropUrls           String[]                 @default([])
  posterUrls             String[]                 @default([])
  // Fase 3 (INSERIES-TRENDING-DISCOVERY-ENGINE-01) — the Premium Discovery Score (0-100):
  // a distinct signal from qualityScore above, weighted towards *discovery* relevance
  // (trending presence, streaming priority, recency) rather than editorial completeness.
  // Computed by lib/discovery/discovery-score.ts, persisted by lib/discovery/engine.ts.
  discoveryScore         Float?
  seasons                Season[]
  reviews                Review[]
  ratings                Rating[]
  statuses               UserSeriesStatus[]
  externalMappings       ExternalSourceMapping[]
  listItems              ListItem[]
  activities             Activity[]
  notifications          Notification[]
  recommendationFeedback RecommendationFeedback[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([status])
  @@index([firstAirYear])
  @@index([popularityScore])
  @@index([voteAverage])
  @@index([qualityScore])
  @@index([discoveryScore])
  @@index([title])
}

model Season {
  id             String          @id @default(cuid())
  seriesId       String
  number         Int
  title          String
  overview       String?
  posterUrl      String?
  airYear        Int?
  episodeCount   Int             @default(0)
  externalSource ExternalSource?
  externalId     String?
  series         Series          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes       Episode[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([seriesId, number])
  @@unique([externalSource, externalId])
}

model Episode {
  id             String                @id @default(cuid())
  seasonId       String
  number         Int
  title          String
  overview       String?
  stillUrl       String?
  runtimeMinutes Int?
  airedAt        DateTime?
  externalSource ExternalSource?
  externalId     String?
  season         Season                @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  progress       UserEpisodeProgress[]
  activities     Activity[]
  notifications  Notification[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([seasonId, number])
  @@unique([externalSource, externalId])
}

model UserSeriesStatus {
  id                String     @id @default(cuid())
  userId            String
  seriesId          String
  state             WatchState
  completionPercent Float      @default(0)
  lastActivityAt    DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  lastWatchedAt     DateTime?
  isFavorite        Boolean    @default(false)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  series            Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([userId, seriesId])
}

model UserEpisodeProgress {
  id        String    @id @default(cuid())
  userId    String
  episodeId String
  watched   Boolean   @default(false)
  watchedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, episodeId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Review {
  id              String         @id @default(cuid())
  userId          String
  seriesId        String
  rating          Int
  body            String
  visibility      Visibility     @default(PUBLIC)
  hiddenByAdminAt DateTime?
  // Fase 2 (INSERIES-REVIEWS-COMMENTS-PREMIUM-01) — aditivo, default false preserva todas as
  // reviews existentes exatamente como estavam.
  containsSpoiler Boolean        @default(false)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  series          Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  activities      Activity[]
  notifications   Notification[]
  comments        Comment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([userId, seriesId])
}

/**
 * Fase 3/4 (INSERIES-REVIEWS-COMMENTS-PREMIUM-01) — comentarios em uma review, com um nivel
 * de resposta via auto-relacao `parentId` (`parent`/`replies`). `hiddenByAdminAt` espelha o
 * mesmo campo/padrao de moderacao ja usado por `Review` (ver `lib/admin/moderation.ts`),
 * ainda que a UI de moderacao de comentarios fique fora do escopo desta sprint.
 */
model Comment {
  id              String     @id @default(cuid())
  userId          String
  reviewId        String
  parentId        String?
  body            String
  hiddenByAdminAt DateTime?
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  review          Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parent          Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]  @relation("CommentReplies")
  activities      Activity[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([reviewId])
  @@index([parentId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  value     Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, seriesId])
}

model List {
  id              String         @id @default(cuid())
  userId          String
  title           String
  description     String?
  visibility      Visibility     @default(PUBLIC)
  hiddenByAdminAt DateTime?
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           ListItem[]
  activities      Activity[]
  notifications   Notification[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ListItem {
  id        String   @id @default(cuid())
  listId    String
  seriesId  String
  position  Int
  note      String?
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listId, seriesId])
  @@unique([listId, position])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  type          NotificationType
  title         String
  body          String
  href          String?
  readAt        DateTime?
  actorUserId   String?
  seriesId      String?
  episodeId     String?
  reviewId      String?
  listId        String?
  achievementId String?
  metadata      Json?
  user          User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actorUser     User?            @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  series        Series?          @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  episode       Episode?         @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  review        Review?          @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  list          List?            @relation(fields: [listId], references: [id], onDelete: SetNull)
  achievement   Achievement?     @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([createdAt])
}

model Activity {
  id               String            @id @default(cuid())
  userId           String
  type             ActivityType
  seriesId         String?
  episodeId        String?
  reviewId         String?
  listId           String?
  commentId        String?
  targetUserId     String?
  metadata         Json?
  visibility       Visibility        @default(PUBLIC)
  user             User              @relation("ActivityUser", fields: [userId], references: [id], onDelete: Cascade)
  series           Series?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episode          Episode?          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  review           Review?           @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  list             List?             @relation(fields: [listId], references: [id], onDelete: Cascade)
  comment          Comment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  targetUser       User?             @relation("ActivityTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  likes            ActivityLike[]
  activityComments ActivityComment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([visibility, createdAt])
}

model ExternalSourceMapping {
  id           String             @id @default(cuid())
  seriesId     String
  source       ExternalSource
  entityType   ExternalEntityType @default(SERIES)
  externalId   String
  lastSyncedAt DateTime?
  series       Series             @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([source, entityType, externalId])
}

model CatalogSyncRun {
  id                   String            @id @default(cuid())
  source               ExternalSource    @default(TMDB)
  type                 CatalogSyncType
  status               CatalogSyncStatus @default(RUNNING)
  startedAt            DateTime          @default(now())
  finishedAt           DateTime?
  importedSeriesCount  Int               @default(0)
  updatedSeriesCount   Int               @default(0)
  importedSeasonCount  Int               @default(0)
  updatedSeasonCount   Int               @default(0)
  importedEpisodeCount Int               @default(0)
  updatedEpisodeCount  Int               @default(0)
  errorMessage         String?
  metadata             Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([type, startedAt])
  @@index([status])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  result      String   @default("SUCCESS")
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([entity, entityId])
}

/// Prepared for future admin-editable system configuration; read/seed-only this sprint.
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  public      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// The catalog of unlockable achievements — seeded once (scripts/seed-achievements.ts), read-only at runtime.
/// The gamification engine (lib/gamification) never invents rows here; it only reads this catalog and writes UserAchievement.
model Achievement {
  id            String              @id @default(cuid())
  slug          String              @unique
  name          String
  description   String
  icon          String
  category      AchievementCategory
  rarity        AchievementRarity   @default(COMMON)
  points        Int
  hidden        Boolean             @default(false)
  unlocks       UserAchievement[]
  notifications Notification[]
  createdAt     DateTime            @default(now())
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  metadata      Json?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

/// INSERIES-RECOMMENDATION-ENGINE-02 — explicit feedback on a recommended series ("Gostei" /
/// "Nao me interessa" / "Ja assisti" / "Ocultar"), one row per user+series (a later action
/// overwrites the earlier one via upsert). The engine reads this back to permanently exclude
/// NOT_INTERESTED/ALREADY_WATCHED/HIDDEN and to suppress genres from NOT_INTERESTED, same as
/// the abandoned-series penalty.
enum RecommendationFeedbackAction {
  LIKE
  NOT_INTERESTED
  ALREADY_WATCHED
  HIDDEN
}

model RecommendationFeedback {
  id        String                       @id @default(cuid())
  userId    String
  seriesId  String
  action    RecommendationFeedbackAction
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series                       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@unique([userId, seriesId])
  @@index([userId, action])
}

/// INSERIES-SUPPORTER-ACTIVATION-01 — one row per support attempt, from PIX generation through
/// manual admin review. Supersedes SupporterContribution's self-reported CONFIRMED status:
/// receipt upload only ever moves this to AWAITING_REVIEW, never grants anything by itself —
/// only `approveSupportRequest` (admin action) creates/extends the UserSupporter record.
enum SupportRequestStatus {
  PENDING_PAYMENT
  AWAITING_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model SupportRequest {
  id          String               @id @default(cuid())
  userId      String
  amountCents Int
  provider    String               @default("PIX")
  status      SupportRequestStatus @default(PENDING_PAYMENT)
  pixTxId     String               @unique
  // Data-URL of the uploaded receipt image — no object storage is provisioned in this
  // environment yet, so the (small, size-capped) image is stored inline rather than pulling in
  // a new external dependency for a first version. Revisit with real blob storage before
  // public launch if receipt volume grows.
  receiptUrl  String?
  notes       String?
  reviewedAt  DateTime?
  reviewedBy  String?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

enum UserSupporterStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// INSERIES-SUPPORTER-ACTIVATION-01 — the single source of truth every benefit reads
/// (`status === ACTIVE`), one row per user (renewals extend `expiresAt` in place, never insert
/// a second row — see lib/supporters/status.ts for the "never lose remaining days" renewal math
/// and the lazy expire-on-read that flips ACTIVE -> EXPIRED once `expiresAt` has passed).
model UserSupporter {
  id               String              @id @default(cuid())
  userId           String              @unique
  status           UserSupporterStatus @default(ACTIVE)
  startedAt        DateTime
  expiresAt        DateTime
  source           String              @default("PIX")
  supportRequestId String?
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

/// Supporters-only polls ("Participacao" — ticket). `options` is a JSON string array (no
/// separate options table needed for a single-choice poll); votes are counted live via
/// SupporterPollVote, never denormalized onto the poll row.
model SupporterPoll {
  id        String              @id @default(cuid())
  question  String
  options   Json
  active    Boolean             @default(true)
  votes     SupporterPollVote[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model SupporterPollVote {
  id          String        @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int
  poll        SupporterPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([pollId, userId])
}

/// INSERIES-SOCIAL-AUTOMATION-01 — scaffolding for a future content-automation system
/// (packages/social-automation) that will draft, review, and publish social posts (Instagram
/// first, more networks later). Nothing in packages/social-automation calls a real social
/// network API yet or runs real AI generation; these models exist so the manual-review flow
/// (draft -> approve -> publish) has somewhere real to persist state end-to-end.
enum SocialContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  FAILED
  ARCHIVED
}

model SocialContent {
  id             String                    @id @default(cuid())
  type           String
  title          String
  description    String
  status         SocialContentStatus       @default(DRAFT)
  templateId     String?
  template       SocialTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  publications   SocialPublication[]
  history        SocialAutomationHistory[]
  // INSERIES-SOCIAL-CONTENT-ENGINE-02 — content-engine payload/source metadata. All nullable so
  // existing rows created by the manual generator (which never sets these) stay valid.
  format         String?
  sourceSeriesId String?
  ctaId          String?
  hookId         String?
  payload        Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([templateId])
  @@index([format])
  @@index([sourceSeriesId])
}

enum SocialNetwork {
  INSTAGRAM
}

/// INSERIES-INSTAGRAM-PUBLISHER-05 — UPLOADING e CANCELLED sao exigidos pelo ciclo real da Meta
/// Graph API (criar media container -> publicar) e pela acao de cancelamento do painel. Nenhum
/// valor pre-existente foi removido: SCHEDULED continua sendo o estado do fluxo "Aprovar e
/// agendar" (ticket-03).
enum SocialPublicationStatus {
  PENDING
  SCHEDULED
  UPLOADING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

model SocialPublication {
  id           String                    @id @default(cuid())
  contentId    String
  content      SocialContent             @relation(fields: [contentId], references: [id], onDelete: Cascade)
  network      SocialNetwork
  caption      String
  mediaRef     String?
  scheduledFor DateTime
  status       SocialPublicationStatus   @default(PENDING)
  publishedAt  DateTime?
  externalId   String?
  /// INSERIES-INSTAGRAM-PUBLISHER-05 — contagem de tentativas de publicacao (retry rastreavel) e
  /// mensagem de erro da ultima falha. `lastError` guarda SOMENTE mensagem ja mascarada pelo
  /// publisher (utils/mask.ts) — nunca token, secret ou payload bruto da Graph API.
  attempts     Int                       @default(0)
  lastError    String?
  history      SocialAutomationHistory[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([contentId])
  @@index([network, status])
  @@index([status, scheduledFor])
}

model SocialTemplate {
  id        String          @id @default(cuid())
  name      String
  type      String
  active    Boolean         @default(true)
  contents  SocialContent[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([type, active])
}

enum SocialAutomationAction {
  CONTENT_GENERATED
  TEMPLATE_RENDERED
  MEDIA_GENERATED
  PUBLISH_ATTEMPTED
  PUBLISH_SUCCEEDED
  PUBLISH_FAILED
  RETRY_SCHEDULED
  CONTENT_SELECTION_STARTED
  CONTENT_CANDIDATES_ANALYZED
  CONTENT_TOPIC_SELECTED
  CONTENT_FALLBACK_APPLIED
  CONTENT_REJECTED_SAFETY
  CONTENT_SUBMITTED_FOR_APPROVAL
  CONTENT_APPROVED
  CONTENT_REJECTED
}

/// Append-only audit trail — every module in packages/social-automation writes here on every
/// action (never silent). Nothing is ever deleted from this table.
model SocialAutomationHistory {
  id            String                 @id @default(cuid())
  publicationId String?
  publication   SocialPublication?     @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  contentId     String?
  content       SocialContent?         @relation(fields: [contentId], references: [id], onDelete: SetNull)
  action        SocialAutomationAction
  detail        Json?
  createdAt     DateTime               @default(now())

  @@index([publicationId, createdAt])
  @@index([contentId, createdAt])
  @@index([action, createdAt])
}
